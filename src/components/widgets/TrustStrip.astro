---
// Verified facts only (handover 3.1, 3.2, 3.3). Years in business and
// accreditations are deliberately absent until the client confirms them (Q1).
// Follows the WidgetWrapper props pattern ({ id, isDark, classes }).
export interface Props {
  id?: string;
  items: string[];
  /** Accessible name for the list. */
  label?: string;
}

const { id, items, label = 'About Peco' } = Astro.props;
---

<section class="border-b border-steel-200 bg-paper" aria-label={label} {...id ? { id } : {}}>
  <div class="container-peco">
    <ul class="grid sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <li class="trust-cell flex items-start gap-3 py-5 text-[0.9375rem] leading-snug font-medium text-ink sm:px-5 sm:py-6 lg:px-6">
            <span class="mt-[0.55em] h-0.5 w-4 shrink-0 bg-ink" aria-hidden="true" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .trust-cell + .trust-cell {
    border-top: 1px solid var(--color-steel-200);
  }
  @media (width >= 40rem) {
    .trust-cell + .trust-cell {
      border-top-width: 0;
    }
    .trust-cell:nth-child(n + 3) {
      border-top: 1px solid var(--color-steel-200);
    }
    .trust-cell:nth-child(2n) {
      border-left: 1px solid var(--color-steel-200);
    }
    .trust-cell:first-child {
      padding-left: 0;
    }
    .trust-cell:nth-child(3) {
      padding-left: 0;
    }
  }
  @media (width >= 64rem) {
    .trust-cell:nth-child(n + 3) {
      border-top-width: 0;
    }
    .trust-cell + .trust-cell {
      border-left: 1px solid var(--color-steel-200);
    }
    .trust-cell:nth-child(3) {
      padding-left: 1.5rem;
    }
  }
</style>
