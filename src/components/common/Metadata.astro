---
// Title, description, canonical, robots and Open Graph basics.
// Replaces AstroWind's @astrolib/seo usage with plain tags.
import { LAUNCH, METADATA, SITE } from '../../lib/config';
import { cleanPath } from '../../navigation';
import { stripBase, url } from '../../lib/url';

const DEFAULT_OG_IMAGE = '/og-default.jpg';
// public/og-default.jpg is the workshop silencer photo.
const DEFAULT_OG_IMAGE_ALT = 'Peco Silencers industrial exhaust silencer in the workshop';

export interface MetaProps {
  /** Page title without the site suffix. Omit on the home page to use the default title. */
  title?: string;
  description?: string;
  /** Defaults to index, follow. Every non-launch build is noindex,nofollow regardless. */
  robots?: { index?: boolean; follow?: boolean };
  /** Absolute or site-relative image URL for og:image. */
  ogImage?: string;
  /** Description of ogImage for og:image:alt / twitter:image:alt. Used only with ogImage. */
  ogImageAlt?: string;
  ogType?: string;
}

const {
  title,
  description = METADATA.description,
  robots = {},
  ogImage,
  ogImageAlt,
  ogType = METADATA.openGraph.type,
} = Astro.props as MetaProps;

const fullTitle = title ? METADATA.title.template.replace('%s', title) : METADATA.title.default;
// Canonical and og:url always name the real domain (SITE.site) and the site path,
// without the build's base: a demo copy (GitHub Pages) is never canonical.
const canonical = new URL(cleanPath(stripBase(Astro.url.pathname)), SITE.site).href;
// Staging and demo builds (LAUNCH unset) are never indexed or followed; a launch
// build keeps the page's own robots (e.g. legal drafts noindex,follow).
const index = LAUNCH && robots.index !== false;
const follow = LAUNCH && robots.follow !== false;
const robotsContent = `${index ? 'index' : 'noindex'},${follow ? 'follow' : 'nofollow'}`;
// og:image is a file in this build, so it uses the build's own site and base.
// Dimensions are only known for the default image (public/og-default.jpg).
const ogImageUrl = new URL(url(ogImage ?? DEFAULT_OG_IMAGE), Astro.site ?? SITE.site).href;
// A page-specific image takes its own alt; without one, no alt is better than the default's.
const ogImageAltText = ogImage ? ogImageAlt : DEFAULT_OG_IMAGE_ALT;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robotsContent} />

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={METADATA.openGraph.site_name} />
<meta property="og:locale" content={METADATA.openGraph.locale} />
<meta property="og:image" content={ogImageUrl} />
{!ogImage && <meta property="og:image:width" content="1200" />}
{!ogImage && <meta property="og:image:height" content="630" />}
{ogImageAltText && <meta property="og:image:alt" content={ogImageAltText} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
{ogImageAltText && <meta name="twitter:image:alt" content={ogImageAltText} />}
