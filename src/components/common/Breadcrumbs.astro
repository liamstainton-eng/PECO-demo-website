---
// Breadcrumb trail: <nav aria-label="Breadcrumb"><ol>, last item is the current page.
export interface Crumb {
  name: string;
  href: string;
}

export interface Props {
  items: Crumb[];
  class?: string;
}

const { items, class: className } = Astro.props;
const last = items.length - 1;
---

<nav aria-label="Breadcrumb" class:list={['text-sm text-steel-600', className]}>
  <ol class="flex flex-wrap items-center gap-y-1">
    {
      items.map((item, i) => (
        <li class="flex items-center">
          {i > 0 && (
            <svg
              class="mx-2 size-3 shrink-0 text-steel-400"
              viewBox="0 0 12 12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              focusable="false"
            >
              <path d="m4.5 2.5 3.5 3.5-3.5 3.5" />
            </svg>
          )}
          {i === last ? (
            <span aria-current="page" class="font-semibold text-ink">
              {item.name}
            </span>
          ) : (
            <a href={item.href} class="link inline-flex min-h-6 items-center text-steel-700 hover:text-ink">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
