---
// Closing call to action for /products, category and pricing pages: Get a quote + Call,
// plus an optional See pricing link (category pages, when PRICING_LIVE).
import WidgetWrapper from '../ui/WidgetWrapper.astro';
import Icon from '../common/Icon.astro';
import { CONTACT, CTA, getQuoteHref } from '../../lib/config';
import { url } from '../../lib/url';

export interface Props {
  title?: string;
  text?: string;
  /** Adds a "See pricing" button, e.g. /pricing#residential. */
  pricingHref?: string;
  /** Screen-reader context for that button, e.g. "for residential silencers". */
  pricingContext?: string;
}

const {
  title = 'Not sure which silencer you need?',
  text = 'Tell us your engine size and noise target and we will recommend a silencer.',
  pricingHref,
  pricingContext,
} = Astro.props;
---

<WidgetWrapper isDark classes={{ container: 'py-12 md:py-14' }}>
  <div class="grid gap-6 border-l-4 border-accent pl-5 md:grid-cols-[1fr_auto] md:items-center md:gap-10 md:pl-8">
    <div>
      <h2 class="text-2xl text-paper md:text-3xl">{title}</h2>
      <p class="mt-3 max-w-[60ch] text-steel-300">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href={url(getQuoteHref())} class="btn btn-primary">{CTA.quoteLabel}</a>
      <a href={CONTACT.phoneHref} class="btn btn-secondary tabular-nums">
        <Icon name="phone" class="size-5" />
        <span><span class="sr-only">Call </span>{CONTACT.phoneDisplay}</span>
      </a>
      {
        pricingHref && (
          <a href={url(pricingHref)} class="btn btn-secondary">
            See pricing{pricingContext && <span class="sr-only"> {pricingContext}</span>}
          </a>
        )
      }
    </div>
  </div>
</WidgetWrapper>
