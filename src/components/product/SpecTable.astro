---
// Size table set like a datasheet.
// - Real <table>: <caption>, <colgroup>s, two header rows (group headers scope="colgroup",
//   unit headers scope="col"), part number as the row header (scope="row").
// - Focusable role="region" scroll box, so the page itself never scrolls sideways.
// - Sticky header rows; sticky first column holding part no., bore (narrow screens)
//   and the "Quote" link for that size.
// - Cells: pair -> in + mm; raw2 -> second printed value, muted, footnoted;
//   holes -> 4 × 11/16" + mm; bolt -> 3/8" + mm; na -> "–"; todo -> "Ask us".
// The CSS-only in/mm toggle from the plan is not included: hiding sub-columns
// breaks the colspan header associations that screen readers rely on.
import TodoValue from '../ui/TodoValue.astro';
import { formatInches } from '../../lib/dims';
import { getQuoteHref } from '../../lib/config';
import type { Column, DimCell, NumCell, PairCell, SizeRow } from '../../lib/csv';

export interface Props {
  model: string;
  slug: string;
  columns: Column[];
  rows: SizeRow[];
}

const { model, slug, columns, rows } = Astro.props;
const captionId = `${slug}-sizes-caption`;
const raw2NoteId = `${slug}-sizes-raw2`;

type Sub = { text: string; muted?: boolean; raw2?: boolean } | { missing: 'todo' };
/** A cell rendered as two sub-columns, or one merged cell when the whole value is n/a or to follow. */
type Out = { span: 'na' } | { span: 'todo' } | { subs: [Sub, Sub] };

const mmText = (mm: number | null): Sub => (mm === null ? { missing: 'todo' } : { text: String(mm) });

function renderDim(cell: DimCell | PairCell): Out {
  switch (cell.kind) {
    case 'na':
      return { span: 'na' };
    case 'todo':
      return { span: 'todo' };
    case 'pair':
      return {
        subs: [
          { text: formatInches(cell.in) },
          cell.raw2 !== undefined ? { text: cell.raw2, muted: true, raw2: true } : mmText(cell.mm),
        ],
      };
    case 'holes':
      return { subs: [{ text: `${cell.count} × ${formatInches(cell.dia)}` }, mmText(cell.mm)] };
    case 'bolt':
      return { subs: [{ text: formatInches(cell.size) }, mmText(cell.mm)] };
  }
}

const numSub = (c: NumCell): Sub | 'na' | 'todo' => (c.kind === 'num' ? { text: String(c.value) } : c.kind);
function renderWeight(w: SizeRow['wt']): Out {
  const lbs = numSub(w.lbs);
  const kg = numSub(w.kg);
  if (lbs === 'na' && kg === 'na') return { span: 'na' };
  if (typeof lbs === 'string' && typeof kg === 'string') return { span: 'todo' };
  const toSub = (s: Sub | 'na' | 'todo'): Sub =>
    s === 'na' ? { text: '–' } : s === 'todo' ? { missing: 'todo' } : s;
  return { subs: [toSub(lbs), toSub(kg)] };
}

const groups = [
  { key: 'bore', label: 'Bore', units: ['in', 'mm'] },
  ...columns.map((c) => ({ key: c.key, label: c.label, units: ['in', 'mm'] })),
  { key: 'wt', label: 'Weight', units: ['lbs', 'kg'] },
];

const hasFig = rows.some((r) => r.fig);

const table = rows.map((r) => ({
  row: r,
  cells: [
    { key: 'bore', label: 'bore', out: renderDim(r.bore) },
    ...columns.map((c) => ({ key: c.key, label: c.label, out: renderDim(r.dims[c.key]) })),
    { key: 'wt', label: 'weight', out: renderWeight(r.wt) },
  ],
}));

const hasRaw2 = table.some((t) => t.cells.some((c) => 'subs' in c.out && c.out.subs.some((s) => 'raw2' in s && s.raw2)));
const hasNa = table.some((t) => t.cells.some((c) => 'span' in c.out && c.out.span === 'na'));

const boreLabel = (b: PairCell): string =>
  b.kind === 'pair' ? `${formatInches(b.in)}${b.mm !== null ? ` / ${b.mm} mm` : ''}` : '';
---

<div class="spec">
  <p class="spec-hint">Scroll the table sideways to see every dimension. Part numbers stay on the left.</p>
  <div role="region" aria-labelledby={captionId} tabindex="0" class="spec-scroll">
    <table class="spec-table">
      <caption id={captionId}>{model} sizes and dimensions (inches / mm)</caption>
      <colgroup><col class="col-part" /></colgroup>
      {hasFig && <colgroup><col /></colgroup>}
      {groups.map(() => <colgroup span="2" />)}
      <thead>
        <tr class="head-groups">
          <th scope="col" rowspan="2" class="sticky-col corner">Part no.</th>
          {hasFig && <th scope="col" rowspan="2" class="fig-col">Fig.</th>}
          {groups.map((g) => <th scope="colgroup" colspan="2" class="group-start">{g.label}</th>)}
        </tr>
        <tr class="head-units">
          {groups.map((g) => g.units.map((u, i) => <th scope="col" class:list={['unit', { 'group-start': i === 0 }]}>{u}</th>))}
        </tr>
      </thead>
      <tbody>
        {
          table.map(({ row, cells }) => (
            <tr>
              <th scope="row" class="sticky-col">
                <span class="part">{row.partNo}</span>
                {row.bore.kind === 'pair' && (
                  <span class="bore-inline" aria-hidden="true">
                    {boreLabel(row.bore)}
                  </span>
                )}
                <a class="quote-size" href={getQuoteHref({ model, slug, size: row.partNo })}>
                  Quote<span class="sr-only"> {row.partNo}</span>
                </a>
              </th>
              {hasFig && <td class="fig-col">{row.fig ?? ''}</td>}
              {cells.map(({ key, label, out }) =>
                'span' in out ? (
                  <td colspan="2" class:list={['group-start merged', out.span]}>
                    {out.span === 'na' ? (
                      <>
                        <span aria-hidden="true">–</span>
                        <span class="sr-only">not applicable</span>
                      </>
                    ) : (
                      <TodoValue model={model} slug={slug} size={row.partNo} context={`about ${row.partNo} ${label}`} />
                    )}
                  </td>
                ) : (
                  out.subs.map((s, i) => (
                    <td class:list={[{ 'group-start': i === 0, muted: 'muted' in s && s.muted }]}>
                      {'missing' in s ? (
                        <TodoValue model={model} slug={slug} size={row.partNo} context={`about ${row.partNo} ${label} ${i === 0 ? 'in inches' : 'in mm'}`} />
                      ) : (
                        <>
                          {s.text}
                          {s.raw2 && (
                            <>
                              <sup aria-hidden="true">†</sup>
                              <span class="sr-only"> (second inch value as printed, see note)</span>
                            </>
                          )}
                          {key === 'bore' && i === 0 && row.markers && (
                            <span class="marker">
                              <span class="sr-only">marked </span>
                              {row.markers}
                            </span>
                          )}
                        </>
                      )}
                    </td>
                  ))
                ),
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    (hasRaw2 || hasNa) && (
      <ul class="spec-legend">
        {hasNa && (
          <li>
            <span aria-hidden="true" class="sym">–</span> Not applicable (printed as * on the datasheet).
          </li>
        )}
        {hasRaw2 && (
          <li id={raw2NoteId}>
            <span aria-hidden="true" class="sym">†</span> Printed on the datasheet as a second inch value in decimal, not
            in mm.
          </li>
        )}
      </ul>
    )
  }
</div>

<style>
  .spec {
    --row-h: 2.25rem;
  }
  .spec-scroll {
    position: relative;
    max-height: min(80vh, 56rem);
    overflow: auto;
    border-top: 2px solid var(--color-ink);
    border-bottom: 2px solid var(--color-ink);
    overscroll-behavior-x: contain;
  }
  .spec-scroll:focus-visible {
    outline-offset: 3px;
  }
  .spec-table {
    border-collapse: separate;
    border-spacing: 0;
    min-width: 100%;
    font-size: 0.8125rem;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }
  @media (width >= 64rem) {
    .spec-table {
      font-size: 0.875rem;
    }
  }
  caption {
    padding: 0.75rem 0.75rem 0.625rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  th,
  td {
    padding: 0.375rem 0.625rem;
    white-space: nowrap;
    text-align: right;
    background-color: var(--color-paper);
  }

  /* Header rows: stick to the top of the scroll box. */
  thead th {
    position: sticky;
    z-index: 2;
    font-weight: 600;
    background-color: var(--color-paper);
  }
  .head-groups th {
    top: 0;
    height: var(--row-h);
    text-align: center;
    border-top: 1px solid var(--color-steel-300);
  }
  .head-units th {
    top: var(--row-h);
    height: 1.75rem;
    text-align: right;
    font-weight: 500;
    color: var(--color-steel-600);
    border-bottom: 1px solid var(--color-ink);
  }
  thead .corner {
    top: 0;
    z-index: 4;
    text-align: left;
    vertical-align: bottom;
    border-bottom: 1px solid var(--color-ink);
  }
  thead .fig-col {
    top: 0;
    vertical-align: bottom;
    border-bottom: 1px solid var(--color-ink);
  }
  .fig-col {
    text-align: center;
    color: var(--color-steel-700);
  }

  /* Group rules, like the vertical lines on the printed datasheet. */
  .group-start {
    border-left: 1px solid var(--color-steel-300);
  }

  /* First column: part no. + quote link, pinned left. */
  .sticky-col {
    position: sticky;
    left: 0;
    z-index: 1;
    text-align: left;
    border-right: 1px solid var(--color-steel-400);
  }
  tbody .sticky-col {
    font-weight: 600;
    min-width: 7.5rem;
  }
  .part {
    display: block;
    color: var(--color-ink);
  }
  .bore-inline {
    display: block;
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--color-steel-600);
  }
  @media (width >= 48rem) {
    .bore-inline {
      display: none;
    }
  }
  .quote-size {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .quote-size:hover {
    color: var(--color-accent-hover);
    text-decoration-thickness: 2px;
  }

  tbody tr > * {
    border-bottom: 1px solid var(--color-steel-200);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  tbody tr:nth-child(even) > * {
    background-color: var(--color-paper-2);
  }
  tbody tr:hover > * {
    background-color: var(--color-steel-100);
  }

  .merged {
    text-align: center;
  }
  .merged.na {
    color: var(--color-steel-400);
  }
  .muted {
    color: var(--color-steel-600);
  }
  sup {
    margin-left: 0.125em;
    font-size: 0.7em;
  }
  .marker {
    margin-left: 0.375em;
    font-size: 0.75em;
    font-weight: 600;
    color: var(--color-steel-700);
  }

  .spec-hint {
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-steel-600);
  }
  .spec-legend {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-steel-700);
  }
  .spec-legend .sym {
    display: inline-block;
    width: 1.25em;
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
