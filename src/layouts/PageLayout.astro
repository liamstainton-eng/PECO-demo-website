---
// Standard page: header, main landmark, footer and mobile CTA bar.
// Layout split adapted from AstroWind src/layouts/PageLayout.astro (MIT, see CREDITS.md).
import Layout from './Layout.astro';
import type { Props as LayoutProps } from './Layout.astro';
import Header from '../components/widgets/Header.astro';
import Footer from '../components/widgets/Footer.astro';
import MobileCtaBar from '../components/widgets/MobileCtaBar.astro';

export interface Props extends LayoutProps {}

const props = Astro.props;
---

<Layout {...props}>
  <Fragment slot="head"><slot name="head" /></Fragment>
  <Header />
  <main id="main" tabindex="-1" class="focus:outline-none">
    <slot />
  </main>
  <Footer />
  <MobileCtaBar />
</Layout>
